// Leaf for suite=gvisor backend=elfuse. Later actions win.
// Recorded from the full bootstrap (2319 cases over 128 binaries:
// 1338 pass, 727 fail, 137 skip, 77 timeout, 25 crash,
// 15 inconsistent), grouped mechanically by binary and observed
// status. A binary whose every case shares one state is compressed
// to a glob, so a new upstream case there inherits the recorded
// state and any behavior change still trips the ratchet.
{
  "actions": [
    { "include": "gvisor.jsonc" },
    {
      "type": "expect_failure",
      "reason": "fails under elfuse while the area is untriaged; recorded from the 2026-08-13 bootstrap against the pinned gVisor payload",
