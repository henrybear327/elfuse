// Account for every *_test cc_binary in the pinned BUILD.
// Decline missing guest facilities, not elfuse failures.
{
  "schema_version": 1,
  "suite_timeout_s": 600,
  "case_timeout_s": 30,     // isolated rerun
  "qemu_mem_mib": 6144,     // large mapping in ReadvTestNoFixture.TruncatedAtMax
