  "declined": [
    { "reason": "x86-only test sources; the AArch64 payload build has nothing to build for them",
      "groups": [
        "32bit_test",
        "arch_prctl_test",
        "exceptions_test",
        "sysret_test",
        "vsyscall_test",
      ] },
    { "reason": "asserts gVisor-internal facilities (kcov coverage device, host getcpu bypass) with no Linux contract to conform to",
      "groups": [
        "getcpu_host_test",
        "kcov_test",
      ] },
    { "reason": "devpts is broken in the current QEMU fixture, so the reference cannot attest these",
      "groups": [
        "host_pty_test",
        "pty_root_test",
        "pty_test",
      ] },
    { "reason": "asserts host-kernel /proc contents beyond the subset elfuse emulates",
      "groups": [
        "proc_isolated_test",
        "proc_net_tcp_test",
        "proc_net_test",
        "proc_net_udp_test",
        "proc_net_unix_test",
        "proc_pid_coredump_test",
        "proc_pid_oomscore_test",
        "proc_pid_smaps_test",
        "proc_pid_uid_gid_map_test",
        "proc_test",
      ] },
    { "reason": "needs privileged host setup or kernel namespaces (capabilities, cgroups, mounts, ptrace, seccomp) outside a single-process syscall translator",
      "groups": [
        "capabilities_test",
        "cgroup2_ebpf_test",
        "cgroup2_test",
        "cgroup_test",
        "chroot_test",
        "fuse_test",
        "mount_fd_test",
        "mount_test",
        "pivot_root_test",
        "ptrace_test",
        "seccomp_test",
        "setns_test",
        "socket_capability_test",
        "sticky_test",
        "unshare_test",
      ] },
    { "reason": "needs kernel network facilities (netlink, netfilter, packet and raw sockets, tun/tap, device binding) or peers outside the guest",
      "groups": [
        "bind_external_test",
        "connect_external_test",
        "ip6tables_test",
        "iptables_test",
        "network_namespace_test",
        "packet_mmap_test",
        "packet_socket_dgram_test",
        "packet_socket_raw_test",
        "packet_socket_test",
        "ping_socket_test",
        "pipe_external_test",
        "raw_socket_hdrincl_test",
        "raw_socket_icmp_test",
        "raw_socket_test",
        "socket_bind_to_device_distribution_test",
        "socket_bind_to_device_sequence_test",
        "socket_bind_to_device_test",
        "socket_ip_unbound_netlink_test",
        "socket_ipv4_udp_unbound_external_networking_test",
        "socket_ipv4_udp_unbound_loopback_netlink_test",
        "socket_ipv6_udp_unbound_external_networking_test",
        "socket_ipv6_udp_unbound_loopback_netlink_test",
        "socket_netdevice_test",
        "socket_netlink_netfilter_test",
        "socket_netlink_route_test",
        "socket_netlink_test",
        "socket_netlink_uevent_test",
        "tuntap_hostinet_test",
        "tuntap_test",
        "udp_raw_socket_test",
      ] },
    { "reason": "socket suites beyond the enabled set; opt-in candidates as the socket translation surface grows",
      "groups": [
        "accept_bind_stream_test",
        "accept_bind_test",
        "bind_test",
        "socket_abstract_non_blocking_test",
        "socket_abstract_test",
        "socket_blocking_ip_test",
        "socket_blocking_local_test",
        "socket_domain_non_blocking_test",
        "socket_domain_test",
        "socket_filesystem_non_blocking_test",
        "socket_filesystem_test",
        "socket_inet_loopback_isolated_test",
        "socket_inet_loopback_nogotsan_test",
        "socket_inet_loopback_test",
        "socket_ip_tcp_generic_loopback_test",
        "socket_ip_tcp_loopback_non_blocking_test",
        "socket_ip_tcp_loopback_test",
        "socket_ip_tcp_udp_generic_loopback_test",
        "socket_ip_udp_loopback_non_blocking_test",
        "socket_ip_udp_loopback_test",
        "socket_ip_unbound_test",
        "socket_ipv4_datagram_based_socket_unbound_loopback_test",
        "socket_ipv4_udp_unbound_loopback_nogotsan_test",
        "socket_ipv4_udp_unbound_loopback_test",
        "socket_ipv6_udp_unbound_loopback_test",
        "socket_ipv6_unbound_test",
        "socket_non_stream_blocking_local_test",
        "socket_non_stream_blocking_udp_test",
        "socket_stream_blocking_local_test",
        "socket_stream_blocking_tcp_test",
        "socket_stream_local_test",
        "socket_stream_nonblock_local_test",
        "socket_stress_test",
        "socket_test",
        "socket_unix_dgram_local_test",
        "socket_unix_dgram_non_blocking_test",
        "socket_unix_pair_test",
        "socket_unix_seqpacket_local_test",
        "socket_unix_stream_listener_close_test",
        "socket_unix_stream_test",
        "socket_unix_unbound_abstract_test",
