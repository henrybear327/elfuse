// Leaf for suite=gvisor backend=qemu, the Linux reference. Later
// actions win. Recorded from the full reference bootstrap
// (2319 cases: 2238 pass, 39 fail, 39 skip, 2 crash,
// 1 inconsistent). A case failing here fails under a real kernel
// in this fixture environment, so it cannot attest an elfuse
// divergence; hanging or self-contradicting cases are skipped so
// the lane never pays their timeouts.
{
  "actions": [
    { "include": "gvisor.jsonc" },
    {
      "type": "expect_failure",
      "reason": "fails under the real kernel in this fixture environment (Alpine linux-virt under QEMU/HVF), recorded from the 2026-08-13 bootstrap",
      "matchers": [
        "gvisor:affinity_test/AffinityTest.ConsistentWithProcCpuInfo",
        "gvisor:affinity_test/AffinityTest.ConsistentWithProcStat",
        "gvisor:affinity_test/AffinityTest.LargeCpuMask",
        "gvisor:affinity_test/AffinityTest.SetAffinityOtherUidRequiresCapSysNice",
        "gvisor:affinity_test/AffinityTest.SmallCpuMask",
        "gvisor:dev_test/DevTest.OpenDevFuse",
        "gvisor:dev_test/DevTest.ReadDevFuseWithoutMount",
        "gvisor:fork_test/CloneTest.NonCanonicalTLS",
        "gvisor:fpsig_nested_test/FPSigTest.NestedSignals",
        "gvisor:getrusage_test/GetrusageTest.Grandchild",
        "gvisor:ioctl_test/IoctlTest.FIOASYNCHandlesFuseFD",
        "gvisor:keys_test/KeysTest.GetCurrentSessionKeyring",
        "gvisor:mq_test/MqTest.OpenNoAccess",
        "gvisor:mq_test/MqTest.OpenReadAccess",
        "gvisor:mq_test/MqTest.OpenWriteAccess",
        "gvisor:pipe_test/Pipes/PipeTest.PipeFdCount/namedblocking",
        "gvisor:pipe_test/Pipes/PipeTest.PipeFdCount/namednonblocking",
        "gvisor:pipe_test/Pipes/PipeTest.PipeFdCount/pipe",
        "gvisor:pipe_test/Pipes/PipeTest.PipeFdCount/pipe2blocking",
        "gvisor:pipe_test/Pipes/PipeTest.PipeFdCount/pipe2nonblocking",
        "gvisor:pipe_test/Pipes/PipeTest.PipeFdCount/smallbuffer",
        "gvisor:prctl_test/PrctlTest.OrphansReparentedToSubreaper",
        "gvisor:rlimits_test/RlimitTest.UnprivilegedSetRlimit",
        "gvisor:rseq_test/RseqTest.Abort",
        "gvisor:rseq_test/RseqTest.AbortBefore",
        "gvisor:rseq_test/RseqTest.AbortClearsCS",
        "gvisor:rseq_test/RseqTest.AbortPreCommit",
        "gvisor:rseq_test/RseqTest.AbortSignature",
        "gvisor:rseq_test/RseqTest.CPU",
        "gvisor:rseq_test/RseqTest.DoubleRegister",
        "gvisor:rseq_test/RseqTest.InvalidAbortClearsCS",
        "gvisor:rseq_test/RseqTest.Register",
        "gvisor:rseq_test/RseqTest.RegisterUnregister",
        "gvisor:rseq_test/RseqTest.Unaligned",
        "gvisor:rseq_test/RseqTest.UnregisterDifferentPtr",
        "gvisor:rseq_test/RseqTest.UnregisterDifferentSignature",
        "gvisor:sigaltstack_test/SigaltstackTest.ResetByExecve",
        "gvisor:sigaltstack_test/SigaltstackTest.WalksOffBottom",
        "gvisor:xattr_test/XattrTest.WriteRemovesSecurityCapability",
      ],
    },
    {
      "type": "expect_skip",
      "reason": "the test skips itself in this fixture environment (GTEST_SKIP probes for facilities the fixture kernel lacks)",
      "matchers": [
        "gvisor:clock_gettime_test/ClockGettime.UnimplementedReturnsEINVAL",
        "gvisor:close_range_test/CloseRangeTest.CloexecAndUnshareFlagTest",
        "gvisor:close_range_test/CloseRangeTest.CloexecFlagTest",
        "gvisor:eventfd_test/EventfdTest.IllegalSeek",
        "gvisor:eventfd_test/EventfdTest.SpliceReturnsEINVAL",
        "gvisor:exec_binary_test/Cases/ElfInterpreterStaticTest.Test/0",
        "gvisor:exec_binary_test/Cases/ElfInterpreterStaticTest.Test/1",
        "gvisor:exec_binary_test/Cases/ElfInterpreterStaticTest.Test/2",
        "gvisor:exec_binary_test/ElfTest.PIEOutOfOrderSegments",
        "gvisor:inotify_test/Inotify.IllegalSeek",
        "gvisor:iouring_test/IOUringTest.NonNullSigsetTest",
        "gvisor:iouring_test/IOUringTest.OverflowCQTest",
        "gvisor:iouring_test/IOUringTest.ReturnedParamsValues",
        "gvisor:iouring_test/IOUringTest.UnsupportedFlags",
        "gvisor:kill_test/KillTest.CanKillAllPIDs",
        "gvisor:link_test/LinkTest.PermissionDenied",
        "gvisor:memory_accounting_test/MemoryAccounting.AnonAccountingPreservedOnSaveRestore",
        "gvisor:personality_test/PersonalityTest.UnsupportedPersonalityBitsAreRejected",
        "gvisor:pidfd_test/PidfdTest.PidfdThreadExecRevival",
        "gvisor:pidfd_test/PidfdTest.PidfdThreadLeaderDelayedNotification",
        "gvisor:pidfd_test/PidfdTest.PidfdThreadSubthreadNotification",
        "gvisor:pidfd_test/PidfdTest.PidfdThreadTracedLeaderNotification",
        "gvisor:pidfd_test/PidfdTest.PidfdThreadTracedSubthreadNotification",
        "gvisor:pipe_test/Pipes/PipeTest.OpenViaProcSelfFD/namedblocking",
        "gvisor:pipe_test/Pipes/PipeTest.OpenViaProcSelfFD/namednonblocking",
        "gvisor:pipe_test/Pipes/PipeTest.OpenViaProcSelfFDWithWrites/namedblocking",
        "gvisor:pipe_test/Pipes/PipeTest.OpenViaProcSelfFDWithWrites/namednonblocking",
        "gvisor:readahead_test/ReadaheadTest.InvalidOffset",
        "gvisor:readahead_test/ReadaheadTest.InvalidSize",
        "gvisor:rlimits_test/RlimitTest.RlimitNProc",
        "gvisor:sendfile_test/SendFileTest.SendPipeWouldBlock",
        "gvisor:sendfile_test/SendFileTest.SendToFullPipeReturnsEAGAIN",
        "gvisor:shm_test/ShmTest.ShmStat",
        "gvisor:statfs_test/FstatfsTest.BlocksFree",
        "gvisor:timerfd_test/AllTimerTypes/TimerfdTest.IllegalSeek/CLOCK_BOOTTIME",
        "gvisor:timerfd_test/AllTimerTypes/TimerfdTest.IllegalSeek/CLOCK_MONOTONIC",
        "gvisor:timerfd_test/TimerfdClockRealtimeTest.ClockAbsoluteRealtimeCancelOnSet",
        "gvisor:xattr_test/XattrTest.SecurityCapacityXattr",
        "gvisor:xattr_test/XattrTest.XattrTrustedWithNonadmin",
      ],
    },
    {
      "type": "skip",
      "reason": "crashes or contradicts its own exit code in this fixture environment; skipped pending triage",
      "matchers": [
        "gvisor:concurrency_test/ConcurrencyTest.MultiProcessConcurrency",
        "gvisor:fault_test/FaultTest.InRange",
        "gvisor:poll_test/PollTest.InvalidFds",
      ],
    },
  ],
}
