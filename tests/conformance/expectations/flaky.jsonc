// Flaky quarantine, appended by the loader after every leaf: retries
// are legal only for tests matched here. Entries carry the evidence in
// "reason".
{
  "actions": [
    {
      "type": "quarantine",
      "reason": "wait timing is racy under elfuse: a normal child's exit is discovered only when the 100 ms pthread_cond_timedwait in sys_wait4 expires, so WNOHANG and post-execve waits flip between runs; flipped in back-to-back full runs on 2026-08-13",
      "matchers": [
        "gvisor:wait_test/Waiters/WaitAnyChildTest.WaitWNOHANG/*",
        "gvisor:wait_test/Waiters/WaitSpecificChildTest.AfterChildExecve/*",
      ],
    },
    {
      "type": "quarantine",
      "reason": "inherently timing-sensitive cases that flipped in back-to-back full runs on 2026-08-13: concurrent-IO splice racing a pipe, and SIGCHLD-ignore racing child reaping",
      "matchers": [
        "gvisor:getrusage_test/GetrusageTest.IgnoreSIGCHLD",
        "gvisor:splice_test/SpliceTest.FromPipeWithConcurrentIo",
      ],
    },
    {
      "type": "quarantine",
      "reason": "wakeup-latency assertions overshoot under virtualized timers on both backends, recorded across repeated reference runs",
      "matchers": [
        "ltp:nanosleep01",
        "ltp:poll02",
        "ltp:pselect01",
        "ltp:select02",
      ],
    },
  ],
}
