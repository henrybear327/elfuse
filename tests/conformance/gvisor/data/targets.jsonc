        "socket_unix_unbound_seqpacket_test",
        "socket_unix_unbound_stream_test",
        "socketopt_test",
        "tcp_socket_test",
        "udp_bind_test",
        "udp_socket_test",
      ] },
    { "reason": "not yet triaged for the lane; opt-in candidates",
      "groups": [
        "bad_test",
        "exec_test",
        "fpsig_mut_test",
        "time_test",
      ] },
  ],
}
